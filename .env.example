# ==============================================================================
# BHARATDC ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or configure in your Render Dashboard
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Server Environment & Port
# Render will automatically assign PORT in production
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Frontend CORS Whitelist
# Set this on Render to your production Vercel frontend URL
# Supports comma-separated origins (e.g. https://bharatdc.vercel.app,http://localhost:3000)
FRONTEND_URL=https://your-app.vercel.app

# Frontend API Base URL (Render production URL or local development)
# Local: http://localhost:5000 | Production: https://bharatdc.onrender.com
VITE_API_URL=http://localhost:5000
